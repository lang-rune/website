{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rune Language",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#booleans"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rune",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rune",
          "match": "\\b(set|write|type|if|else|otherwise|while|spell|cast|return|repeat|count|from|to|as|times|skip|stop|empty)\\b"
        },
        {
          "name": "keyword.operator.logical.rune",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rune",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rune",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.rune",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.rune",
          "match": "\\+|\\-|\\*|\\/|\\%"
        },
        {
          "name": "keyword.operator.comparison.rune",
          "match": "==|!=|<|>|<=|>="
        },
        {
          "name": "keyword.operator.assignment.rune",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rune",
          "match": "\\b(write|type)\\b(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.rune",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.rune",
      "match": "\\b(yes|no|true|false)\\b"
    }
  },
  "scopeName": "source.rune"
}